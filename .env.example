# ============================================================================
# CONFIGURAÇÕES DE SEGURANÇA E SERVIDOR (BACKEND - RENDER)
# Copie este arquivo para ".env" localmente. NUNCA comite o arquivo ".env" real!
# ============================================================================

# Senha de acesso ao Painel Administrativo (Obrigatória)
ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"

# Chave secreta usada para assinar os tokens de sessão do Admin (Opcional - gerada automaticamente se omitida)
ADMIN_TOKEN_SECRET="CHANGE_ME_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"

# Conexão com o Supabase PostgreSQL (OBRIGATÓRIO para persistência no Render Free)
# Copie da aba Project Settings -> Database -> URI (Transaction pooler ou direct) no Supabase:
# Exemplo: postgresql://postgres.xxxxxx:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres?sslmode=require"

# Caminho de fallback do arquivo SQLite (utilizado apenas se DATABASE_URL não for informado)
SQLITE_DB_PATH="./data/awards.db"

# Origens permitidas no CORS (separadas por vírgula). Ex: https://seu-projeto.vercel.app
FRONTEND_ORIGIN="http://localhost:3000,http://localhost:5173"

# Porta do servidor Express
PORT=3000

# ============================================================================
# CONFIGURAÇÕES DO FRONTEND (VERCEL)
# ============================================================================

# URL pública do backend hospedado no Render (sem barra no final).
# Opcional se usar a regra de rewrite configurada no vercel.json.
VITE_API_URL=""
